<Project>
  <Import Project="..\Directory.Build.props"/>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Package selection (xunit v2 vs v3, Microsoft.NET.Test.Sdk version) differs per CluedIn
       target/TFM - see Packages.props - so it's not listed here unconditionally. Each test csproj
       adds its own conditional ItemGroups instead. -->
  <ItemGroup>
    <PackageReference Include="coverlet.msbuild"/>
    <PackageReference Include="Moq"/>
    <PackageReference Include="Shouldly"/>
  </ItemGroup>
</Project>
