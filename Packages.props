<Project>
  <PropertyGroup Label="Dependency Versions">
    <_AutoFixture>5.0.0-preview0012</_AutoFixture>
    <!-- Guarded so the pipeline's -p:_CluedIn=<version> per build leg wins -->
    <_CluedIn Condition="'$(_CluedIn)' == ''">5.0.0-*</_CluedIn>
    <_CluedInVersionSuffix>$(_CluedIn.Split('-')[0].Replace('.', ''))</_CluedInVersionSuffix>
  </PropertyGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies in test projects, common to every target

        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="coverlet.msbuild" Version="2.8.0" />
    <PackageReference Update="Moq" Version="4.13.1" />
    <PackageReference Update="Shouldly" Version="3.0.2" />
  </ItemGroup>
  <!-- xunit v3 + AutoFixture.Xunit3 + CluedIn.Testing.Base for net10.0 (CluedIn 5.0+); xunit v2 +
       AutoFixture.Xunit2 + the version-suffixed CluedIn.Testing.Base package (each CluedIn leg
       publishes CluedIn.Testing.Base under a different, dotless-Major.Minor.Patch-suffixed package
       ID - CluedIn.Testing.Base.470/.480/.500, not a single ID versioned by $(_CluedIn) - see
       CluedIn.Enricher.GoogleMaps' migration doc) for net6.0 (CluedIn &lt; 5.0). -->
  <ItemGroup Condition="$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Update="AutoFixture.Xunit3" Version="$(_AutoFixture)" />
    <PackageReference Update="xunit.v3" Version="3.2.2" />
    <PackageReference Update="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Update="CluedIn.Testing.Base.$(_CluedInVersionSuffix)" Version="1.0.0-*" />
  </ItemGroup>
  <ItemGroup Condition="!$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Update="AutoFixture.Xunit2" Version="4.18.0" />
    <PackageReference Update="xunit" Version="2.9.3" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Update="CluedIn.Testing.Base.$(_CluedInVersionSuffix)" Version="1.0.0-*" />
  </ItemGroup>
  <ItemGroup>
    <!--
        Specified versions for dependencies across the solution

        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
    <PackageReference Update="CluedIn.Core" Version="$(_CluedIn)" />
    <PackageReference Update="CluedIn.ExternalSearch" Version="$(_CluedIn)" />
  </ItemGroup>
  <ItemGroup Label="Global tools">
    <!--
            Automatically added to each project with :
            - IncludeAssets="Analyzers;Build"
            - PrivateAssets="All"

            DO NOT NEED TO BE ADDED AS A PACKAGEREFERENCE
        -->
    <!-- <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" /> -->
  </ItemGroup>
</Project>